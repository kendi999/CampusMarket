<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusMarket.ViewModels"
             xmlns:models="clr-namespace:CampusMarket.Models"
             x:Class="CampusMarket.Views.MessagesPage"
             x:DataType="vm:MessagesViewModel"
             Title="Messages"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12">

        <!-- En-tête -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" Text="Campus" FontSize="18"
                   TextColor="{StaticResource GrisTexte}" VerticalOptions="Center" />
                        <Image Grid.Column="1" Source="logo.png"
                   WidthRequest="48" HeightRequest="48" />
            <Border Grid.Column="3"
                    BackgroundColor="{StaticResource Lavande}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    WidthRequest="56" HeightRequest="56">
                <Label Text="{Binding Initiales}" FontAttributes="Bold" FontSize="13"
                       TextColor="{StaticResource Indigo}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <Label Grid.Row="1" Text="{Binding NomCampus}"
               FontAttributes="Bold" FontSize="16" TextColor="Black" />

        <!-- Recherche -->
        <Border Grid.Row="2" Style="{StaticResource ChampBordure}">
            <Entry Placeholder="Rechercher message"
                   Text="{Binding Recherche}"
                   Style="{StaticResource ChampEntry}" />
        </Border>

        <!-- Filtres -->
        <ScrollView Grid.Row="3" Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="10">

                <Button Text="Tous" CornerRadius="12" HeightRequest="40" Padding="18,0"
                        BackgroundColor="{StaticResource Lavande}"
                        TextColor="{StaticResource Indigo}"
                        Command="{Binding ChoisirFiltreCommand}" CommandParameter="Tous">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Tous">
                            <Setter Property="BackgroundColor" Value="{StaticResource Indigo}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Non lus" CornerRadius="12" HeightRequest="40" Padding="18,0"
                        BackgroundColor="{StaticResource Lavande}"
                        TextColor="{StaticResource Indigo}"
                        Command="{Binding ChoisirFiltreCommand}" CommandParameter="Non lus">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Non lus">
                            <Setter Property="BackgroundColor" Value="{StaticResource Indigo}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Favoris" CornerRadius="12" HeightRequest="40" Padding="18,0"
                        BackgroundColor="{StaticResource Lavande}"
                        TextColor="{StaticResource Indigo}"
                        Command="{Binding ChoisirFiltreCommand}" CommandParameter="Favoris">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Favoris">
                            <Setter Property="BackgroundColor" Value="{StaticResource Indigo}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Groupes" CornerRadius="12" HeightRequest="40" Padding="18,0"
                        BackgroundColor="{StaticResource Lavande}"
                        TextColor="{StaticResource Indigo}"
                        Command="{Binding ChoisirFiltreCommand}" CommandParameter="Groupes">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Groupes">
                            <Setter Property="BackgroundColor" Value="{StaticResource Indigo}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Liste des discussions -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding DiscussionsAffichees}"
                        SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="Aucune discussion"
                       TextColor="{StaticResource GrisTexte}"
                       HorizontalOptions="Center" Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Discussion">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="0,2">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource Lavande}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 32"
                                WidthRequest="64" HeightRequest="64">
                            <Label Text="{Binding Interlocuteur.Initiales}"
                                   FontAttributes="Bold" FontSize="17"
                                   TextColor="{StaticResource Indigo}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Interlocuteur.NomComplet}"
                                   FontAttributes="Bold" FontSize="17" TextColor="Black" />
                            <Label Text="{Binding DernierMessage}" FontSize="16"
                                   TextColor="{StaticResource GrisTexte}"
                                   LineBreakMode="TailTruncation" MaxLines="1">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding NonLu}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Indigo}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding InfoTexte}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource GrisTexte}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>